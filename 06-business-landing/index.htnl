<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Umair's Chai & Classes - Bansdih</title>
<link rel="stylesheet" href="style.css">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@700&family=Inter:wght@400;500&display=swap" rel="stylesheet">
</head>
<body>

<!-- HERO - position + z-index ka use -->
<section class="hero">
    <div class="hero-bg"></div>
    <div class="overlay"></div>
    <div class="hero-content">
        <h1>Padhai. Chai. Sukoon.</h1>
        <p>Bansdih ka pehla cafe + study library. High-speed WiFi, AC hall, aur kadak chai.</p>
        <a href="#contact" class="cta-btn">Book Your Seat Now</a>
        <p class="hero-tag">Starting @ ₹29 / hour</p>
    </div>
</section>

<!-- ABOUT / SERVICES - 3 card variants -->
<section class="services">
    <h2 class="section-title">Hamari Services</h2>
    <div class="cards-container">
        <!-- Card 1: border-radius + shadow -->
        <div class="card card-1">
            <div class="icon-box">☕</div>
            <h3>Chai & Snacks</h3>
            <p>Kulhad chai, cold coffee, samosa, maggi. Padhte-padhte bhookh lagi to tension nahi.</p>
            <span class="price">From ₹15</span>
        </div>
        <!-- Card 2: different background + border -->
        <div class="card card-2">
            <div class="icon-box">📚</div>
            <h3>Silent Study Zone</h3>
            <p>AC Library, individual desk, charging point. DDU students ke liye special discount.</p>
            <span class="price">₹29 / hr</span>
        </div>
        <!-- Card 3: dashed border + overflow -->
        <div class="card card-3">
            <div class="icon-box">🎯</div>
            <h3>MERN Tuition</h3>
            <p>Evening me MERN Stack, HTML/CSS classes. Umair Beg khud padhate hain. Live projects.</p>
            <span class="price">Join Now</span>
        </div>
    </div>
</section>

<!-- GALLERY - images + overflow -->
<section class="gallery">
    <h2 class="section-title">Gallery & Reviews</h2>
    <div class="gallery-box">
        <div class="gallery-item"><img src="https://images.unsplash.com/photo-1509042239860-f550ce710b93?w=500" alt="cafe"><p>Our Chai Counter</p></div>
        <div class="gallery-item"><img src="https://images.unsplash.com/photo-1521017432531-fbd92d768814?w=500" alt="study"><p>Study Hall</p></div>
        <div class="gallery-item"><img src="https://images.unsplash.com/photo-1486312338219-ce68d2c6f44d?w=500" alt="students"><p>Happy Students</p></div>
    </div>
    <div class="testimonial">
        <p>"Bansdih me aisi jagah ki bahut zarurat thi. Ab mera daily adda hai." - <b>Aman, DDU Student</b></p>
    </div>
</section>

<!-- CONTACT -->
<section id="contact" class="contact">
    <h2 class="section-title">Seat Book Karo</h2>
    <div class="contact-wrapper">
        <div class="contact-info">
            <h3>Visit Us</h3>
            <p>Near Bansdih Road, Ballia, UP - 277304</p>
            <p>Time: 8am - 10pm Daily</p>
            <p>Call: +91 98XXX XXXXX</p>
        </div>
        <form class="contact-form">
            <input type="text" placeholder="Tumhara Naam" required>
            <input type="tel" placeholder="Mobile Number" required>
            <select><option>Chai + Study (₹29/hr)</option><option>MERN Tuition</option><option>Full Day Pass</option></select>
            <textarea placeholder="Message..."></textarea>
            <button type="submit">Send Request</button>
        </form>
    </div>
</section>

<footer>
    <div class="footer-links">
        <a href="#">Home</a> <a href="#contact">Contact</a> <a href="#">Instagram</a> <a href="#">Menu</a>
    </div>
    <p>© 2026 Umair's Chai & Classes | Made with ❤️ in Bansdih by Umair Beg</p>
</footer>

</body>
</html>
